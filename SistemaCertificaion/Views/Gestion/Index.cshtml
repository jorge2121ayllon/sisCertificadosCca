@model SistemaCertificaion.ViewModels.GestionAcademicaViewModel

@{
    ViewData["Title"] = "Gestión Académica";
}

<div class="gestion-container">

    <!-- ENCABEZADO -->
    <div class="gestion-header">
        <div>
            <span class="gestion-subtitle">SISTEMA DE ADMINISTRACIÓN</span>
            <h2>Gestión Académica</h2>
            <p>Control de cursos, alumnos, inscripciones y proceso de certificación.</p>
        </div>

        <div class="header-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </div>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- SELECCIÓN DE CURSO Y REGISTRO -->
    <div class="row g-4 mb-4">

        <div class="col-lg-5">
            <div class="panel-card h-100">

                <div class="panel-heading">
                    <div class="panel-heading-icon blue">
                        <i class="bi bi-book-fill"></i>
                    </div>
                    <div>
                        <h5>Seleccionar curso</h5>
                        <small>Consultar la gestión académica</small>
                    </div>
                </div>

                <div class="panel-body">
                    <form asp-action="Index" method="get">

                        <label class="form-label">Curso académico</label>

                        <select name="cursoId" class="form-select mb-3">
                            <option value="">Seleccione un curso</option>

                            @foreach (var curso in Model.Cursos)
                            {
                                if (curso.Id == Model.CursoId)
                                {
                                    <option value="@curso.Id" selected>
                                        @curso.Codigo - @curso.Nombre
                                    </option>
                                }
                                else
                                {
                                    <option value="@curso.Id">
                                        @curso.Codigo - @curso.Nombre
                                    </option>
                                }
                            }
                        </select>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-2"></i>
                            Cargar curso
                        </button>

                    </form>
                </div>

            </div>
        </div>

        <div class="col-lg-7">
            <div class="panel-card h-100">

                <div class="panel-heading">
                    <div class="panel-heading-icon green">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>
                    <div>
                        <h5>Registrar nuevo curso</h5>
                        <small>Crear una nueva actividad académica</small>
                    </div>
                </div>

                <div class="panel-body">
                    <form asp-action="CrearCurso" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label">Código</label>
                                <input asp-for="NuevoCurso.Codigo"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">Nombre del curso</label>
                                <input asp-for="NuevoCurso.Nombre"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Inicio</label>
                                <input asp-for="NuevoCurso.FechaInicio"
                                       type="date"
                                       class="form-control" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Fin</label>
                                <input asp-for="NuevoCurso.FechaFin"
                                       type="date"
                                       class="form-control" />
                            </div>

                        </div>

                        <button type="submit" class="btn btn-success mt-3">
                            <i class="bi bi-save me-2"></i>
                            Registrar curso
                        </button>

                    </form>
                </div>

            </div>
        </div>

    </div>

    @if (Model.CursoSeleccionado != null)
    {
        <!-- INFORMACIÓN DEL CURSO -->
        <div class="curso-banner mb-4">

            <div class="curso-banner-info">
                <span class="curso-label">
                    CURSO SELECCIONADO
                </span>

                <h3>@Model.CursoSeleccionado.Nombre</h3>

                <p>
                    <i class="bi bi-upc-scan me-2"></i>
                    Código:
                    <strong>@Model.CursoSeleccionado.Codigo</strong>
                </p>
            </div>

            <div class="curso-banner-status">
                <span class="status-dot"></span>
                Curso activo
            </div>

        </div>

        <!-- ESTADÍSTICAS -->
        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">
                <div class="stat-card stat-blue">
                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <span>Alumnos inscritos</span>
                        <h2>@Model.TotalInscritos</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card stat-purple">
                    <div class="stat-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <span>Certificados registrados</span>
                        <h2>@Model.TotalCertificados</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card stat-green">
                    <div class="stat-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <span>Certificados entregados</span>
                        <h2>@Model.TotalEntregados</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card stat-orange">
                    <div class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <span>Pendientes de entrega</span>
                        <h2>@Model.TotalPendientes</h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- INSCRIBIR ALUMNO EXISTENTE -->
        <div class="panel-card mb-4">

            <div class="panel-heading">
                <div class="panel-heading-icon cyan">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h5>Inscribir alumno existente</h5>
                    <small>Agregar un alumno registrado al curso</small>
                </div>
            </div>

            <div class="panel-body">

                <form asp-action="InscribirAlumno" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="cursoId"
                           value="@Model.CursoId" />

                    <div class="row g-3">

                        <div class="col-md-9">
                            <label class="form-label">Seleccionar alumno</label>

                            <select name="alumnoId" class="form-select" required>
                                <option value="">Seleccione un alumno</option>

                                @foreach (var alumno in Model.Alumnos)
                                {
                                    <option value="@alumno.Id">
                                        @alumno.Apellidos, @alumno.Nombres - @alumno.Ci
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-info text-white w-100">
                                <i class="bi bi-person-check-fill me-2"></i>
                                Inscribir alumno
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>

        <!-- REGISTRAR ALUMNO NUEVO -->
        <div class="panel-card mb-4">

            <div class="panel-heading">
                <div class="panel-heading-icon orange">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>
                <div>
                    <h5>Registrar alumno e inscribir</h5>
                    <small>Crear un nuevo alumno y asignarlo al curso</small>
                </div>
            </div>

            <div class="panel-body">

                <form asp-action="CrearAlumnoInscribir" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="cursoId"
                           value="@Model.CursoId" />

                    <div class="row g-3">

                        <div class="col-md-3">
                            <label class="form-label">Nombres</label>
                            <input name="Nombres"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Apellidos</label>
                            <input name="Apellidos"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">CI</label>
                            <input name="Ci"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Celular</label>
                            <input name="Celular"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Correo electrónico</label>
                            <input name="Email"
                                   type="email"
                                   class="form-control" />
                        </div>

                    </div>

                    <button type="submit" class="btn btn-warning mt-3">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Registrar e inscribir
                    </button>

                </form>

            </div>
        </div>

        <!-- PROCESO DE CERTIFICACIÓN -->
        <div class="panel-card">

            <div class="certificado-heading">

                <div class="certificado-heading-left">
                    <div class="panel-heading-icon navy">
                        <i class="bi bi-file-earmark-medical-fill"></i>
                    </div>

                    <div>
                        <h5>Proceso de certificación</h5>
                        <small>Seguimiento de las etapas de cada certificado</small>
                    </div>
                </div>

                <div class="process-legend">
                    <span>
                        <i class="legend-circle completed"></i>
                        Completado
                    </span>
                    <span>
                        <i class="legend-circle pending"></i>
                        Pendiente
                    </span>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table certificate-table align-middle">

                    <thead>
                        <tr>
                            <th class="student-column">Alumno</th>
                            <th>CI</th>
                            <th>ISPI</th>
                            <th>Proceso</th>
                            <th>Generado</th>
                            <th>Impresión</th>
                            <th>DNA</th>
                            <th>Finalizado</th>
                            <th>SMS retiro</th>
                            <th>Entregado</th>
                            <th>Observación / Archivo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Inscripciones)
                        {
                            var certificado = item.Certificaciones
                                .FirstOrDefault(c => c.Activo);

                            <tr>

                                <td class="student-column">
                                    <div class="student-info">
                                        <div class="student-avatar">
                                            @item.Alumno.Nombres.Substring(0, 1)
                                        </div>

                                        <div>
                                            <strong>
                                                @item.Alumno.Nombres
                                                @item.Alumno.Apellidos
                                            </strong>
                                            <small>Alumno inscrito</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="ci-badge">
                                        @item.Alumno.Ci
                                    </span>
                                </td>

                                @if (certificado == null)
                                {
                                    <td colspan="8">
                                        <div class="no-certificate">
                                            <i class="bi bi-file-earmark-x"></i>
                                            <span>Certificado no registrado</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted small">
                                            Sin observación
                                        </span>
                                    </td>

                                    <td>
                                        <form asp-action="AgregarCertificado"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="inscripcionId"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="cursoId"
                                                   value="@Model.CursoId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                <i class="bi bi-plus-circle me-1"></i>
                                                Crear
                                            </button>
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <!-- ISPI -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Ispi,
                                            certificado.FechaIspi?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Ispi",
                                            "ISPI",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- PROCESO -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Proceso,
                                            certificado.FechaProceso?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Proceso",
                                            "Proceso",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- GENERADO -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Generado,
                                            certificado.FechaGenerado?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Generado",
                                            "Generado",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- IMPRESIÓN -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Impresion,
                                            certificado.FechaImpresion?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Impresion",
                                            "Impresión",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- DNA -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.EnviadoDna,
                                            certificado.FechaEnviadoDna?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "EnviadoDna",
                                            "Enviado DNA",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- FINALIZADO -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Finalizado,
                                            certificado.FechaFinalizado?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Finalizado",
                                            "Finalizado",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- SMS RETIRO -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.SmsRetiro,
                                            certificado.FechaSmsRetiro?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "SmsRetiro",
                                            "SMS Retiro",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- ENTREGADO -->
                                    <td>
                                        @EstadoCertificado(
                                            certificado.Entregado,
                                            certificado.FechaEntregado?.ToString("dd/MM/yyyy"),
                                            certificado.Id,
                                            "Entregado",
                                            "Entregado",
                                            item.Alumno.Nombres + " " + item.Alumno.Apellidos)
                                    </td>

                                    <!-- OBSERVACIÓN Y ARCHIVO -->
                                    <td class="observation-column">

                                        @if (!string.IsNullOrWhiteSpace(certificado.Observacion))
                                        {
                                            <div class="observation-text">
                                                @certificado.Observacion
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Sin observación
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(certificado.UrlArchivo))
                                        {
                                            <a href="@certificado.UrlArchivo"
                                               target="_blank"
                                               rel="noopener"
                                               class="file-link">
                                                <i class="bi bi-paperclip"></i>
                                                Ver archivo
                                            </a>
                                        }

                                    </td>

                                    <!-- ACCIONES -->
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary btn-observation"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalObservacion@(certificado.Id)">

                                            <i class="bi bi-pencil-square me-1"></i>
                                            Editar
                                        </button>
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Inscripciones.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <h5>No hay alumnos inscritos</h5>
                    <p>Inscriba alumnos para comenzar el proceso de certificación.</p>
                </div>
            }

        </div>

        <!-- MODALES DE OBSERVACIÓN -->
        @foreach (var item in Model.Inscripciones)
        {
            var certificado = item.Certificaciones
                .FirstOrDefault(c => c.Activo);

            if (certificado != null)
            {
                <div class="modal fade"
                     id="modalObservacion@(certificado.Id)"
                     tabindex="-1"
                     aria-labelledby="tituloObservacion@(certificado.Id)"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered modal-lg">

                        <div class="modal-content observation-modal">

                            <form asp-action="ActualizarObservacion"
                                  method="post"
                                  enctype="multipart/form-data">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="certificadoId"
                                       value="@certificado.Id" />

                                <input type="hidden"
                                       name="cursoId"
                                       value="@Model.CursoId" />

                                <div class="modal-header observation-modal-header">

                                    <div class="modal-title-area">
                                        <div class="modal-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>

                                        <div>
                                            <h5 class="modal-title"
                                                id="tituloObservacion@(certificado.Id)">
                                                Observación y documentación
                                            </h5>

                                            <p>
                                                @item.Alumno.Nombres
                                                @item.Alumno.Apellidos
                                            </p>
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>

                                </div>

                                <div class="modal-body p-4">

                                    <!-- OBSERVACIÓN -->
                                    <div class="mb-4">

                                        <label class="form-label modal-label">
                                            <i class="bi bi-chat-left-text me-2"></i>
                                            Observación
                                        </label>

                                        <textarea name="observacion"
                                                  class="form-control observation-textarea"
                                                  rows="4"
                                                  placeholder="Escriba aquí las observaciones relacionadas con el certificado...">@certificado.Observacion</textarea>

                                        <small class="text-muted">
                                            Registre detalles, aclaraciones o información importante.
                                        </small>

                                    </div>

                                    <!-- ARCHIVO -->
                                    <div class="file-upload-section">

                                        <label class="form-label modal-label">
                                            <i class="bi bi-paperclip me-2"></i>
                                            Adjuntar documento
                                        </label>

                                        <div class="upload-area">

                                            <div class="upload-icon">
                                                <i class="bi bi-cloud-arrow-up-fill"></i>
                                            </div>

                                            <div class="upload-content">

                                                <h6>Seleccione un archivo</h6>

                                                <p>
                                                    PDF, Word, Excel o imagen.
                                                    Tamaño máximo: 10 MB.
                                                </p>

                                                <input type="file"
                                                       name="archivo"
                                                       class="form-control"
                                                       accept=".pdf,.docx,.xlsx,.png,.jpg,.jpeg" />

                                            </div>

                                        </div>

                                        <!-- ARCHIVO EXISTENTE -->
                                        @if (!string.IsNullOrWhiteSpace(certificado.UrlArchivo))
                                        {
                                            <div class="current-file">

                                                <div class="current-file-icon">
                                                    <i class="bi bi-file-earmark-check-fill"></i>
                                                </div>

                                                <div class="current-file-info">
                                                    <strong>Archivo actualmente guardado</strong>
                                                    <small>
                                                        Puede abrirlo para consultarlo.
                                                    </small>
                                                </div>

                                                <a href="@certificado.UrlArchivo"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="bi bi-eye me-1"></i>
                                                    Ver archivo
                                                </a>

                                            </div>
                                        }

                                    </div>

                                </div>

                                <div class="modal-footer observation-modal-footer">

                                    <button type="button"
                                            class="btn btn-light"
                                            data-bs-dismiss="modal">
                                        Cancelar
                                    </button>

                                    <button type="submit"
                                            class="btn btn-primary">
                                        <i class="bi bi-save me-2"></i>
                                        Guardar cambios
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>
            }
        }
    }

</div>

<!-- MODAL CONFIRMAR ESTADO -->
<div class="modal fade"
     id="modalConfirmarEstado"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content state-confirm-modal">

            <div class="modal-header">
                <div>
                    <span class="confirm-label">CONFIRMACIÓN</span>
                    <h5 class="modal-title">
                        Actualizar etapa
                    </h5>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body text-center">

                <div class="confirm-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h5>¿Desea completar esta etapa?</h5>

                <p class="text-muted">
                    Se registrará el estado del certificado.
                </p>

                <div class="confirm-info">
                    <span>Alumno</span>
                    <strong id="alumnoEstado"></strong>
                </div>

                <div class="confirm-info">
                    <span>Etapa</span>
                    <strong id="nombreEstado"></strong>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <a href="#"
                   id="btnConfirmarEstado"
                   class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>
                    Confirmar
                </a>

            </div>

        </div>

    </div>

</div>

<!-- MÉTODO PARA MOSTRAR CADA ETAPA -->
@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent EstadoCertificado(
        bool completado,
        string? fecha,
        int certificadoId,
        string accion,
        string nombreEstado,
        string alumno)
    {
        if (completado)
        {
            return new Microsoft.AspNetCore.Html.HtmlString(
                $@"<div class='process-step completed'>
                    <div class='process-check'>
                        <i class='bi bi-check-lg'></i>
                    </div>
                    <span class='process-date'>{fecha ?? "Completado"}</span>
                </div>");
        }

        var url = Url.Action(
            "CambiarEstado",
            "Gestion",
            new
            {
                certificadoId = certificadoId,
                accion = accion
            });

        var urlHtml = System.Text.Encodings.Web.HtmlEncoder.Default
            .Encode(url ?? "#");

        var estadoHtml = System.Text.Encodings.Web.HtmlEncoder.Default
            .Encode(nombreEstado);

        var alumnoHtml = System.Text.Encodings.Web.HtmlEncoder.Default
            .Encode(alumno);

        return new Microsoft.AspNetCore.Html.HtmlString(
            $@"<a href='#'
                class='process-step pending btn-confirmar-estado'
                data-bs-toggle='modal'
                data-bs-target='#modalConfirmarEstado'
                data-url='{urlHtml}'
                data-estado='{estadoHtml}'
                data-alumno='{alumnoHtml}'>
                    <div class='process-pending-icon'>
                        <i class='bi bi-clock'></i>
                    </div>
                    <span>Pendiente</span>
                </a>");
    }
}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modalConfirmarEstado =
                document.getElementById("modalConfirmarEstado");

            if (modalConfirmarEstado) {

                modalConfirmarEstado.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const boton = event.relatedTarget;

                        if (!boton) return;

                        const url = boton.getAttribute("data-url");
                        const estado = boton.getAttribute("data-estado");
                        const alumno = boton.getAttribute("data-alumno");

                        document
                            .getElementById("btnConfirmarEstado")
                            .setAttribute("href", url);

                        document
                            .getElementById("nombreEstado")
                            .innerText = estado;

                        document
                            .getElementById("alumnoEstado")
                            .innerText = alumno;
                    });
            }

            // Mostrar el nombre del archivo seleccionado
            document.querySelectorAll('input[type="file"]').forEach(function (input) {

                input.addEventListener("change", function () {

                    const archivo = this.files[0];

                    if (archivo && archivo.size > 10 * 1024 * 1024) {
                        alert("El archivo supera el tamaño máximo de 10 MB.");
                        this.value = "";
                    }
                });
            });

        });
    </script>
}

