@using SistemaCertificaion.ViewModels
@model CursoVM

<div class="container-fluid">

    <!-- ENCABEZADO -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-journal-bookmark-fill text-primary"></i>
                        Gestión de Cursos
                    </h2>

                    <p class="text-muted mb-0">
                        Administración de cursos, capacitaciones y programas académicos
                    </p>

                </div>

                <a asp-action="Create"
                       class="btn btn-nuevo">

                    <i class="bi bi-plus-circle-fill"></i>
                    Nuevo Curso

                </a>

            </div>

        </div>

    </div>

    <!-- BUSCADOR -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-10">

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control form-control-lg"
                               placeholder="Buscar por código o nombre del curso..." />

                    </div>

                    <div class="col-md-2 d-grid">

                        <button type="submit"
                                class="btn btn-buscar">

                            <i class="bi bi-search"></i>
                            Buscar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLA -->

    <div class="card shadow-sm border-0 rounded-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="tabla-header">

                    <tr>

                        <th>ID</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th class="text-center">Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Cursos.Any())
                    {
                        @foreach (var item in Model.Cursos)
                        {
                            <tr>

                                <td><strong>#@item.Id</strong></td>

                                <td>@item.Codigo</td>

                                <td>
                                    <strong>@item.Nombre</strong>
                                </td>

                                <td>@item.FechaInicio?.ToString("dd/MM/yyyy")</td>

                                <td>@item.FechaFin?.ToString("dd/MM/yyyy")</td>

                                <td>

                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success rounded-pill">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.FechaRegistro.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <div class="acciones">

                                     
                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-editar"
                                               title="Editar">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-eliminar"
                                               title="Eliminar">

                                            <i class="bi bi-trash-fill"></i>

                                        </a>

                                        <a asp-action="Inscripcion"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-inscripcion"
                                               title="Inscripciones">

                                            <i class="bi bi-people-fill"></i>

                                        </a>

                                        <a asp-action="Certificado"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-certificado"
                                               title="Certificados">

                                            <i class="bi bi-award-fill"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8" class="text-center py-5">

                                <i class="bi bi-journal-x fs-1 text-muted"></i>

                                <div class="mt-3">
                                    No existen cursos registrados.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINACIÓN -->

    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap">

        <div class="text-muted">

            Página
            <strong>@Model.PaginaActual</strong>
            de
            <strong>@Model.TotalPaginas</strong>

        </div>

        <nav>

            <ul class="pagination mb-0">

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">

                        <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-buscar="@Model.Buscar">

                            @i

                        </a>

                    </li>
                }

            </ul>

        </nav>

    </div>

</div>

<style>

    .btn-nuevo {
        background: #38bdf8;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
    }

        .btn-nuevo:hover {
            background: #0ea5e9;
            color: white;
        }

    .btn-buscar {
        background: #111827;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
    }

        .btn-buscar:hover {
            background: #1f2937;
            color: white;
        }

    .form-control {
        border-radius: 10px;
    }

        .form-control:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 .15rem rgba(56,189,248,.25);
        }

    .tabla-header th {
        background: #111827 !important;
        color: white !important;
        border: none;
        padding: 16px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f8fafc;
    }

    .acciones {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        text-decoration: none;
        transition: .3s;
    }

    .btn-ver {
        background: #e0f2fe;
        color: #0284c7;
    }

        .btn-ver:hover {
            background: #0284c7;
            color: white;
        }

    .btn-editar {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-editar:hover {
            background: #d97706;
            color: white;
        }

    .btn-eliminar {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-eliminar:hover {
            background: #dc2626;
            color: white;
        }

    .btn-inscripcion {
        background: #dcfce7;
        color: #16a34a;
    }

        .btn-inscripcion:hover {
            background: #16a34a;
            color: white;
        }

    .btn-certificado {
        background: #ede9fe;
        color: #7c3aed;
    }

        .btn-certificado:hover {
            background: #7c3aed;
            color: white;
        }

    .page-item.active .page-link {
        background: #111827;
        border-color: #111827;
    }

    .page-link {
        color: #111827;
    }

</style>