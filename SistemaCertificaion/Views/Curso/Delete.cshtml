@model Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <div class="card-body">
                <div class="alert alert-warning">
                    ¿Estás seguro de que deseas eliminar este Curso?
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Codigo</dt>
                    <dd class="col-sm-8">@Model.Codigo</dd>

                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">FechaInicio</dt>
                    <dd class="col-sm-8">@Model.FechaInicio</dd>

                    <dt class="col-sm-4">FechaFin</dt>
                    <dd class="col-sm-8">@Model.FechaFin</dd>

                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            Eliminar
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>