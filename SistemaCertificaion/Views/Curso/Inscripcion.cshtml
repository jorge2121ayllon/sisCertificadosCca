@model SistemaCertificaion.ViewModels.CursoInscripcionViewModel

@{
    ViewData["Title"] = "Inscripción de alumnos";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Gestión de Inscripciones</h3>
            <small class="text-muted">
                @Model.NombreCurso | Código: @Model.CodigoCurso
            </small>
        </div>

        <span class="badge bg-primary fs-6 px-3 py-2">
            <i class="bi bi-people"></i>
            @Model.Inscripciones.Count inscritos
        </span>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BUSCADOR PRO -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">

            <form asp-action="AdicionarAlumno" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="cursoId" value="@Model.CursoId" />
                <input type="hidden" id="alumnoId" name="alumnoId" required />

                <label class="form-label fw-semibold">Buscar alumno</label>

                <input type="text" id="buscadorAlumno"
                       class="form-control form-control-lg"
                       placeholder="Escribe nombre, apellido, CI, celular o email...">

                <div id="listaAlumnos" class="list-group mt-2 buscador-lista"></div>

                <button type="submit" class="btn btn-success mt-3 w-100">
                    <i class="bi bi-plus-lg"></i> Adicionar
                </button>
            </form>

        </div>
    </div>

    <!-- TABLA -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">
                <h5 class="fw-bold">Lista de alumnos</h5>

                <input type="text" id="buscarTabla"
                       class="form-control w-25"
                       placeholder="Buscar en tabla...">
            </div>

            <div class="table-responsive">
                <table class="table align-middle" id="tabla">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Alumno</th>
                            <th>CI</th>
                            <th>Celular</th>
                            <th>Email</th>
                            <th>Fecha</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Inscripciones)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <strong>@item.Alumno.Nombres @item.Alumno.Apellidos</strong>
                                </td>

                                <td>@item.Alumno.Ci</td>
                                <td>@item.Alumno.Celular</td>
                                <td>@item.Alumno.Email</td>
                                <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>

                                <td class="text-end">
                                    <form asp-action="QuitarAlumno" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="inscripcionId" value="@item.Id" />
                                        <input type="hidden" name="cursoId" value="@Model.CursoId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('¿Quitar alumno?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="text-end mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Volver
                </a>
            </div>

        </div>
    </div>

</div>

<!-- DATA DESDE MODEL -->
<script>
    const alumnos = [
        @foreach (var a in Model.Alumnos)
        {
                <text>
                    {
                        id: @a.Id,
                        nombre: "@a.Nombres @a.Apellidos",
                        ci: "@a.Ci",
                        celular: "@a.Celular",
                        email: "@a.Email"
                    },
                </text>
        }
    ];
</script>

<!-- JS -->
<script>
    const input = document.getElementById("buscadorAlumno");
    const lista = document.getElementById("listaAlumnos");
    const alumnoIdInput = document.getElementById("alumnoId");

    input.addEventListener("keyup", function () {
        const filtro = input.value.toLowerCase();
        lista.innerHTML = "";

        if (filtro.length < 1) return;

        const resultados = alumnos.filter(a =>
            (a.nombre && a.nombre.toLowerCase().includes(filtro)) ||
            (a.ci && a.ci.toLowerCase().includes(filtro)) ||
            (a.celular && a.celular.toLowerCase().includes(filtro)) ||
            (a.email && a.email.toLowerCase().includes(filtro))
        );

        resultados.slice(0, 10).forEach(a => {

            const item = document.createElement("div");
            item.classList.add("list-group-item", "list-group-item-action");

            item.innerHTML = `
                <strong>${a.nombre}</strong><br>
                <small>CI: ${a.ci || '-'} | 📱 ${a.celular || '-'}</small>
            `;

            item.addEventListener("click", function () {
                input.value = a.nombre;
                alumnoIdInput.value = a.id;
                lista.innerHTML = "";
            });

            lista.appendChild(item);
        });
    });

    // cerrar lista
    document.addEventListener("click", function (e) {
        if (!e.target.closest("#buscadorAlumno")) {
            lista.innerHTML = "";
        }
    });

    // filtro tabla
    document.getElementById("buscarTabla").addEventListener("keyup", function () {
        const value = this.value.toLowerCase();
        document.querySelectorAll("#tabla tbody tr").forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(value) ? "" : "none";
        });
    });
</script>

<!-- CSS -->
<style>
    .buscador-lista {
        max-height: 250px;
        overflow-y: auto;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .list-group-item:hover {
        background: #f1f5f9;
        cursor: pointer;
    }
</style>