@model Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-dark text-white border-0 py-4">

                    <h3 class="mb-1 fw-bold text-center">
                        <i class="bi bi-person-plus-fill text-info"></i>
                        Nuevo Usuario
                    </h3>

                    <p class="text-center mb-0 text-light">
                        Registro de administradores del sistema
                    </p>

                </div>

                <div class="card-body p-4">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">

                            <i class="bi bi-exclamation-triangle-fill me-2"></i>

                            @TempData["Error"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="NombreUsuario"
                                   class="form-label fw-semibold">

                                Usuario

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                <input asp-for="NombreUsuario"
                                       class="form-control"
                                       placeholder="Ingrese el nombre de usuario" />

                            </div>

                            <span asp-validation-for="NombreUsuario"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">

                                Correo Electrónico

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="correo@institucion.com" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Clave"
                                   class="form-label fw-semibold">

                                Contraseña

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>

                                <input asp-for="Clave"
                                       type="password"
                                       class="form-control"
                                       placeholder="Ingrese la contraseña" />

                            </div>

                            <span asp-validation-for="Clave"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- ROL FIJO -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Rol

                            </label>

                            <input type="text"
                                   asp-for="Rol"
                                   class="form-control bg-light"
                                   value="Administrador"
                                   readonly />

                            <small class="text-muted">

                                Todos los usuarios creados desde este formulario tendrán rol Administrador.

                            </small>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                                   class="btn btn-outline-secondary rounded-3">

                                <i class="bi bi-arrow-left-circle"></i>
                                Volver

                            </a>

                            <button type="submit"
                                    class="btn btn-guardar">

                                <i class="bi bi-check-circle-fill"></i>
                                Guardar Usuario

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .card {
        overflow: hidden;
    }

    .input-group-text {
        background: #f8fafc;
        min-width: 45px;
        justify-content: center;
    }

    .form-control {
        padding: 10px;
    }

        .form-control:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 .15rem rgba(56,189,248,.25);
        }

    .btn-guardar {
        background: #38bdf8;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-guardar:hover {
            background: #0ea5e9;
            color: white;
        }

    .alert {
        border-radius: 12px;
    }

</style>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}