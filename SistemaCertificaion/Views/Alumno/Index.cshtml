@using SistemaCertificaion.ViewModels
@model AlumnoVM

<div class="container-fluid">

    <!-- ENCABEZADO -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-mortarboard-fill text-primary"></i>
                        Gestión de Alumnos
                    </h2>

                    <p class="text-muted mb-0">
                        Administración y seguimiento de estudiantes registrados
                    </p>

                </div>

                <a asp-action="Create"
                       class="btn btn-nuevo">

                    <i class="bi bi-person-plus-fill"></i>
                    Nuevo Alumno

                </a>

            </div>

        </div>

    </div>

    <!-- BUSCADOR -->

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-10">

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control form-control-lg"
                               placeholder="Buscar por nombre, apellido, CI o correo..." />

                    </div>

                    <div class="col-md-2 d-grid">

                        <button class="btn btn-buscar">

                            <i class="bi bi-search"></i>
                            Buscar

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLA -->

    <div class="card shadow-sm border-0 rounded-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="tabla-header">

                    <tr>

                        <th>ID</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>CI</th>
                        <th>Celular</th>
                        <th>Email</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th class="text-center">Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Alumnos.Any())
                    {
                        @foreach (var item in Model.Alumnos)
                        {
                            <tr>

                                <td>
                                    <strong>#@item.Id</strong>
                                </td>

                                <td>@item.Nombres</td>

                                <td>@item.Apellidos</td>

                                <td>@item.Ci</td>

                                <td>@item.Celular</td>

                                <td>@item.Email</td>

                                <td>

                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success rounded-pill">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.FechaRegistro.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <div class="acciones">

                                        <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-ver"
                                               title="Ver">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-editar"
                                               title="Editar">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-eliminar"
                                               title="Eliminar">

                                            <i class="bi bi-trash-fill"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center py-5">

                                <i class="bi bi-database-x fs-1 text-muted"></i>

                                <div class="mt-3">

                                    No se encontraron registros.

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINACIÓN -->

    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap">

        <div class="text-muted">

            Página
            <strong>@Model.PaginaActual</strong>
            de
            <strong>@Model.TotalPaginas</strong>

        </div>

        <nav>

            <ul class="pagination mb-0">

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">

                        <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-buscar="@Model.Buscar">

                            @i

                        </a>

                    </li>
                }

            </ul>

        </nav>

    </div>

</div>

<style>

    body {
        background: #f4f6f9;
    }

    .btn-nuevo {
        background: #38bdf8;
        color: white;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        border: none;
    }

        .btn-nuevo:hover {
            background: #0ea5e9;
            color: white;
        }

    .btn-buscar {
        background: #111827;
        color: white;
        border: none;
        font-weight: 600;
    }

        .btn-buscar:hover {
            background: #1f2937;
            color: white;
        }

    .tabla-header th {
        background: #111827 !important;
        color: white !important;
        border: none;
        padding: 16px;
    }

    .table tbody td {
        padding: 15px;
        vertical-align: middle;
    }

    .table tbody tr {
        transition: .2s;
    }

        .table tbody tr:hover {
            background: #f8fafc;
        }

    .acciones {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .btn-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        text-decoration: none;
        transition: .3s;
    }

    .btn-ver {
        background: #e0f2fe;
        color: #0284c7;
    }

        .btn-ver:hover {
            background: #0284c7;
            color: white;
        }

    .btn-editar {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-editar:hover {
            background: #d97706;
            color: white;
        }

    .btn-eliminar {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-eliminar:hover {
            background: #dc2626;
            color: white;
        }

    .page-item.active .page-link {
        background: #111827;
        border-color: #111827;
    }

    .page-link {
        color: #111827;
    }

        .page-link:hover {
            color: #38bdf8;
        }

</style>