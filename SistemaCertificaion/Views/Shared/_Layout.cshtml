<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema de Certificaciones</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

   
    
    <style>

            /* ==========================
                           GENERAL
                ========================== */

            body {
                background: #f4f6f9;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                color: #1e293b;
            }

            /* ==========================
                           NAVBAR
                ========================== */

            .navbar-custom {
                background: #111827;
                padding: 12px 0;
                box-shadow: 0 4px 18px rgba(0,0,0,.15);
                position: relative;
                z-index: 1000;
            }

            .navbar-brand {
                color: white !important;
                font-weight: 700;
                font-size: 1.1rem;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                white-space: nowrap;
            }

                .navbar-brand:hover {
                    color: #38bdf8 !important;
                }

            .logo-icon {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: linear-gradient(135deg, #38bdf8, #0284c7);
                display: flex;
                justify-content: center;
                align-items: center;
                color: white;
                font-size: 22px;
                box-shadow: 0 4px 12px rgba(56,189,248,.2);
                flex-shrink: 0;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.2;
            }

                .brand-text small {
                    color: #9ca3af;
                    font-size: 10px;
                    letter-spacing: 1.5px;
                    margin-top: 5px;
                    font-weight: 500;
                }

            /* ==========================
                           LINKS NAVBAR
                ========================== */

            .navbar-custom .nav-link {
                color: #d1d5db !important;
                font-weight: 500;
                font-size: 13px;
                padding: 10px 12px !important;
                border-radius: 8px;
                display: flex;
                align-items: center;
                gap: 7px;
                transition: all .3s ease;
                white-space: nowrap;
            }

                .navbar-custom .nav-link i {
                    font-size: 16px;
                }

                .navbar-custom .nav-link:hover {
                    background: rgba(255,255,255,.08);
                    color: #38bdf8 !important;
                }

                .navbar-custom .nav-link.active {
                    background: rgba(56,189,248,.15);
                    color: #38bdf8 !important;
                }

            /* ==========================
                           LINEA INSTITUCIONAL
                ========================== */

            .linea-institucional {
                height: 3px;
                background: linear-gradient( to right, #38bdf8 0%, #38bdf8 50%, #facc15 50%, #facc15 100% );
            }

            /* ==========================
                           USUARIO
                ========================== */

            .navbar-user {
                margin-left: 15px;
            }

            .usuario-toggle {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 12px;
                border-radius: 30px;
                background: rgba(255,255,255,.08);
                color: white !important;
                text-decoration: none;
                border: 1px solid rgba(255,255,255,.1);
                transition: .3s;
            }

                .usuario-toggle:hover {
                    background: rgba(255,255,255,.14);
                }

            .usuario-avatar {
                width: 35px;
                height: 35px;
                border-radius: 50%;
                background: #38bdf8;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #111827;
                font-size: 17px;
                flex-shrink: 0;
            }

            .usuario-info {
                display: flex;
                flex-direction: column;
                line-height: 1.2;
            }

                .usuario-info strong {
                    font-size: 13px;
                    font-weight: 600;
                }

                .usuario-info small {
                    font-size: 10px;
                    color: #9ca3af;
                    margin-top: 3px;
                }

            /* ==========================
                           DROPDOWN USUARIO
                ========================== */

            .usuario-menu {
                background: white;
                border: none;
                border-radius: 12px;
                padding: 8px;
                min-width: 190px;
                margin-top: 10px !important;
                box-shadow: 0 8px 25px rgba(0,0,0,.15);
            }

                .usuario-menu .dropdown-item {
                    padding: 10px 12px;
                    border-radius: 8px;
                    font-size: 14px;
                    color: #374151;
                    transition: .2s;
                }

                    .usuario-menu .dropdown-item:hover {
                        background: #eff6ff;
                        color: #2563eb;
                    }

                .usuario-menu .logout-link {
                    color: #dc2626;
                }

                    .usuario-menu .logout-link:hover {
                        background: #fef2f2;
                        color: #b91c1c;
                    }

            /* ==========================
                           BOTÓN LOGIN
                ========================== */

            .btn-login {
                background: linear-gradient(135deg, #38bdf8, #0284c7);
                color: white !important;
                border: none;
                border-radius: 25px;
                padding: 10px 18px;
                font-weight: 600;
                font-size: 13px;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                transition: all .3s ease;
                white-space: nowrap;
            }

                .btn-login:hover {
                    background: #0ea5e9;
                    color: white !important;
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(56,189,248,.25);
                }

            /* ==========================
                           CONTENIDO
                ========================== */

            .contenido {
                background: white;
                border-radius: 16px;
                padding: 30px;
                min-height: 75vh;
                box-shadow: 0 5px 20px rgba(0,0,0,.06);
            }

            /* ==========================
                           FOOTER
                ========================== */

            .footer-custom {
                background: #111827;
                color: #d1d5db;
                padding: 25px 20px;
                text-align: center;
                margin-top: 40px;
                font-size: 13px;
            }

                .footer-custom strong {
                    color: #facc15;
                    font-size: 15px;
                }

                .footer-custom .footer-icon {
                    color: #38bdf8;
                    margin-right: 6px;
                }

            /* ==========================
                           BOTÓN RESPONSIVE
                ========================== */

            .navbar-toggler {
                border: 1px solid rgba(255,255,255,.2);
                border-radius: 10px;
                padding: 8px 11px;
            }

                .navbar-toggler:focus {
                    box-shadow: 0 0 0 3px rgba(56,189,248,.2);
                }

            .navbar-toggler-icon {
                width: 1.3em;
                height: 1.3em;
            }

            /* ==========================
                           RESPONSIVE
                ========================== */

            @@media (max-width: 1199px) {
                .navbar-brand {
                    font-size: 1rem;
                }

                .navbar-custom .nav-link {
                    padding: 9px 10px !important;
                    font-size: 12px;
                }
            }

            @@media (max-width: 991px) {

                .navbar-custom .navbar-collapse {
                    margin-top: 15px;
                    padding-top: 15px;
                    border-top: 1px solid rgba(255,255,255,.1);
                }

                .navbar-custom .navbar-nav {
                    align-items: stretch;
                    width: 100%;
                    gap: 5px;
                }

                .navbar-custom .nav-link {
                    padding: 12px 15px !important;
                    font-size: 14px;
                }

                .navbar-user {
                    margin-left: 0;
                    margin-top: 12px;
                }

                .usuario-toggle {
                    width: 100%;
                }

                .usuario-info {
                    flex: 1;
                }

                .usuario-menu {
                    width: 100%;
                }

                .btn-login {
                    justify-content: center;
                    margin-top: 10px;
                }

                .contenido {
                    padding: 20px;
                }
            }

            @@media (max-width: 576px) {

                .navbar-brand {
                    font-size: 14px;
                }

                .logo-icon {
                    width: 38px;
                    height: 38px;
                    font-size: 18px;
                }

                .brand-text small {
                    font-size: 9px;
                }

                .contenido {
                    padding: 15px;
                    border-radius: 12px;
                }

                .footer-custom {
                    margin-top: 25px;
                }
            }

    </style>

</head>
<body>

    <!-- CABECERA -->
    <!-- CABECERA PRINCIPAL -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">

                <!-- LOGO Y NOMBRE DEL SISTEMA -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <div class="logo-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <div class="brand-text">
                        <span>Sistema de Certificaciones</span>
                        <small>GESTIÓN ACADÉMICA</small>
                    </div>
                </a>

                <!-- BOTÓN RESPONSIVE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menu"
                        aria-controls="menu"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENÚ DE NAVEGACIÓN -->
                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav mx-auto">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door"></i>
                                Inicio
                            </a>
                        </li>

                        <!-- VER CERTIFICADO -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alumno" && ViewContext.RouteData.Values["action"]?.ToString() == "Buscar" ? "active" : "")"
                               asp-controller="Alumno"
                               asp-action="Buscar">

                                <i class="bi bi-file-earmark-check"></i>
                                Ver Certificado
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- ALUMNOS -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alumno" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-controller="Alumno"
                                   asp-action="Index">

                                    <i class="bi bi-people"></i>
                                    Alumnos
                                </a>
                            </li>

                            <!-- CURSOS -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Curso" ? "active" : "")"
                                   asp-controller="Curso"
                                   asp-action="Index">

                                    <i class="bi bi-book"></i>
                                    Cursos
                                </a>
                            </li>

                            <!-- USUARIOS -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" ? "active" : "")"
                                   asp-controller="Usuario"
                                   asp-action="Index">

                                    <i class="bi bi-person-gear"></i>
                                    Usuarios
                                </a>
                            </li>

                            <!-- IMPORTACIÓN -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Importacion" ? "active" : "")"
                                   asp-controller="Importacion"
                                   asp-action="Index">

                                    <i class="bi bi-file-earmark-excel"></i>
                                    Importación
                                </a>
                            </li>

                            <!-- GESTIÓN ACADÉMICA -->
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gestion" ? "active" : "")"
                                   asp-controller="Gestion"
                                   asp-action="Index">

                                    <i class="bi bi-calendar2-check"></i>
                                    Gestión Académica
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- ÁREA DE USUARIO -->
                    <ul class="navbar-nav navbar-user">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- USUARIO -->
                            <li class="nav-item dropdown">

                                <a class="usuario-toggle dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <div class="usuario-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div class="usuario-info">
                                        <strong>@User.Identity.Name</strong>
                                        <small>Sesión activa</small>
                                    </div>
                                </a>

                                <!-- DROPDOWN -->
                                <ul class="dropdown-menu dropdown-menu-end usuario-menu">

                                    <li>
                                        <span class="dropdown-item-text">
                                            <i class="bi bi-person-circle me-2"></i>
                                            Usuario del sistema
                                        </span>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item logout-link"
                                           asp-controller="Auth"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- INICIAR SESIÓN -->
                            <li class="nav-item">
                                <a class="btn-login"
                                   asp-controller="Auth"
                                   asp-action="Login">

                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- LÍNEA INSTITUCIONAL -->
        <div class="linea-institucional"></div>
    </header>

    <!-- CONTENIDO -->

    <div class="container mt-4">

        <div class="contenido">

            @RenderBody()

        </div>

    </div>

    <!-- FOOTER -->

    <footer class="footer-custom">

        <div class="container">

            <strong>Sistema de Certificaciones</strong>

            <br />

            Gestión Académica y Emisión de Certificados

            <br />

            © 2026 Todos los derechos reservados

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>