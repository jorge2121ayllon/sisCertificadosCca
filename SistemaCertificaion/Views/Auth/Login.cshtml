@model SistemaCertificaion.ViewModels.LoginViewModel

<div class="container">

    <div class="row justify-content-center align-items-center"
         style="min-height:80vh;">

        <div class="col-lg-5 col-md-7">

            <div class="card login-card border-0">

                <div class="login-header text-center">

                    <div class="logo-circle">
                        🎓
                    </div>

                    <h2 class="mt-3 mb-1">
                        Sistema de Certificaciones
                    </h2>

                    <p class="mb-0">
                        Acceso al Sistema Académico
                    </p>

                </div>

                <div class="card-body p-5">

                    <form asp-action="Login" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Password"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="Recordarme"
                                   class="form-check-input" />

                            <label asp-for="Recordarme"
                                   class="form-check-label">
                            </label>

                        </div>

                        <button type="submit"
                                class="btn btn-login-custom w-100">

                            Ingresar al Sistema

                        </button>

                    </form>

                </div>

                <div class="login-footer">

                    Gestión Académica y Emisión de Certificados

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


<style>

    .login-card {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.15);
    }

    .login-header {
        background: #111827;
        color: white;
        padding: 35px;
        border-top: 4px solid #38bdf8;
        border-bottom: 4px solid #facc15;
    }

    .logo-circle {
        width: 80px;
        height: 80px;
        margin: auto;
        border-radius: 50%;
        background: rgba(255,255,255,.10);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .login-header h2 {
        font-weight: 700;
    }

    .login-header p {
        color: #d1d5db;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #d1d5db;
    }

        .form-control:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 .2rem rgba(56,189,248,.25);
        }

    .btn-login-custom {
        background: #38bdf8;
        color: white;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-login-custom:hover {
            background: #0ea5e9;
            color: white;
            transform: translateY(-2px);
        }

    .login-footer {
        background: #f8fafc;
        text-align: center;
        padding: 15px;
        color: #6b7280;
        font-size: .9rem;
    }

</style>
