@model IEnumerable<Alumno>

<h1>LISTA DE ALUMNOS</h1>

<table class="table table-hover table-dark">
    <a asp-action="Create" class="btn btn-light btn-sm fw-semibold">Adicionar</a>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Ci</th>
            <th>Celular</th>
            <th>Email</th>
            <th>Activo</th>
            <th>FechaRegistro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombres</td>
                <td>@item.Apellidos</td>
                <td>@item.Ci</td>
                <td>@item.Celular</td>
                <td>@item.Email</td>
                <td>@item.Activo</td>
                <td>@item.FechaRegistro</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn.sm" >Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn.sm">Eliminar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning btn.sm">Ver</a>
                </td>
            </tr>
        }
    </tbody>
</table>