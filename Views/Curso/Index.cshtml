@model IEnumerable<Curso>

<table class="table table-hover table-dark">
    <a asp-action="Create" class="btn btn-light btn-sm fw-semibold btn-danger">Adicionar</a>
    <thead>
        <tr>
            <th>Id</th>
            <th>Codigo</th>
            <th>Nombre</th>
            <th>FechaInicio</th>
            <th>FechaFin</th>
            <th>Activo</th>
            <th>FechaRegistro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>@item.FechaInicio</td>
                <td>@item.FechaFin</td>
                <td>@item.Activo</td>
                <td>@item.FechaRegistro</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn.sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn.sm">Eliminar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning btn.sm">Ver</a>
                    <a asp-action="Inscripcion" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                        Inscripción
                    </a>
                    <a asp-action="Certificacion" asp_route-id="@item.Id" class="btn btn-primary btn-sm">
                </td>
            </tr>
        }
    </tbody>
</table>