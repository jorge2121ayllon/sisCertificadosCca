@model IEnumerable<Usuario>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-light">Gestión de Usuarios</h2>
        <a asp-action="Create" class="btn btn-success btn-sm d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Nuevo
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle text-center shadow-sm">
            <thead class="table-secondary text-dark">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Id</td>
                        <td>@item.NombreUsuario</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @item.Rol
                            </span>
                        </td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            @item.FechaRegistro.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>